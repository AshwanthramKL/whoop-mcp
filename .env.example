# whoop-mcp — example environment configuration.
# Copy to .env (or export in your shell) and fill in. Never commit .env.

# ------ REQUIRED ------

# From your WHOOP developer app at
# https://developer-dashboard.whoop.com/apps/create
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# ------ OPTIONAL (defaults shown) ------

# OAuth callback URI registered in your WHOOP dev app. Change only if you
# registered a non-default one.
# WHOOP_REDIRECT_URI=http://localhost:8000/callback

# Override the cache DB location (default: ~/.whoop-mcp-server/whoop.db)
# WHOOP_DB_PATH=

# Logging. WHOOP_LOG_JSON=false switches to human-readable format.
# WHOOP_LOG_FILE empty string disables the rotating file handler entirely.
# WHOOP_LOG_LEVEL=INFO
# WHOOP_LOG_FILE=
# WHOOP_LOG_JSON=true
